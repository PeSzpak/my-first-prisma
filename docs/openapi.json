    "components": {
        "schemas": {
            "CreateUserDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "Email do usuario"
                    },
                    "name": {
                        "type": "string",
                        "description": "nome completo do usuario"
                    },
                    "admin": {
                        "type": "boolean",
                        "description": "Define se o usuario é administrador",
                        "default": false
                    }
                },
                "required": [
                    "email",
                    "name",
                    "admin"
                ]
            },
            "UserEntity": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "email": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "admin": {
                        "type": "boolean"
                    },
                    "createdAt": {
                        "format": "date-time",
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "email",
                    "name",
                    "admin",
                    "createdAt"
                ]
            },
            "UpdateUserDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "Email do usuario"
                    },
                    "name": {
                        "type": "string",
                        "description": "nome completo do usuario"
                    },
                    "admin": {
                        "type": "boolean",
                        "description": "Define se o usuario é administrador",
                        "default": false
                    }
                }
            },
            "CreatePostDto": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "description": "titulo do post"
                    },
                    "content": {
                        "type": "string",
                        "nullable": true,
                        "description": "conteudo do post"
                    },
                    "authorEmail": {
                        "type": "string",
                        "format": "email",
                        "description": "Email do criador do post"
                    }
                },
                "required": [
                    "title",
                    "content"
                ]
            },
            "PostEntity": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "published": {
                        "type": "boolean"
                    },
                    "title": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string",
                        "nullable": true
                    },
                    "createdAt": {
                        "format": "date-time",
                        "type": "string"
                    },
                    "updateAt": {
                        "format": "date-time",
                        "type": "string"
                    },
                    "authorId": {
                        "type": "number",
                        "nullable": true
                    }
                },
                "required": [
                    "id",
                    "published",
                    "title",
                    "content",
                    "createdAt",
                    "updateAt",
                    "authorId"
                ]
            },
            "UpdatePostDto": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "description": "titulo do post"
                    },
                    "content": {
                        "type": "string",
                        "nullable": true,
                        "description": "conteudo do post"
                    },
                    "authorEmail": {
                        "type": "string",
                        "format": "email",
                        "description": "Email do criador do post"
                    }
                }
            }
        }
